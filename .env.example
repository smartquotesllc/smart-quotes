# Canonical public site URL (used for sitemap / absolute links)
NEXT_PUBLIC_SITE_URL=https://www.smartquotesllc.com

# Smart Quotes OS CRM ingest (server-only — never use NEXT_PUBLIC_)
# Browser → website /api/rfq → this URL
CRM_INGEST_URL=https://app.smartquotesllc.com/api/ingest/lead
# Must match the OS INGEST_API_KEY. Sent as header: x-sq-ingest-key
CRM_INGEST_API_KEY=

# Set to false to disable vacation-offer side-channel queueing after RFQ
VACATION_OFFER_ENABLED=true
